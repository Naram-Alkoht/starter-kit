{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "dev": "vp dev",
        "lint": "vp check --fix && prettier --write --no-error-on-unmatched-pattern \"resources/**/*.blade.php\"",
        "test:lint": "vp check && prettier --check --no-error-on-unmatched-pattern \"resources/**/*.blade.php\""
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.1.11",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "playwright": "^1.65.0",
        "tailwindcss": "^4.0.7",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
        "vite-plus": "1.4.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.4.2",
            "onFail": "download"
        }
    },
    "devDependencies": {
        "prettier": "^3.10.0",
        "prettier-plugin-blade": "^3.3.3",
        "prettier-plugin-tailwindcss": "^0.8.1"
    }
}
